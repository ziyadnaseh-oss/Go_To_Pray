<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/prayerRowContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Active Indicator Dot / Icon -->
    <View
        android:id="@+id/viewActiveIndicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_stop_adhan_button"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Prayer Name in Arabic -->
    <TextView
        android:id="@+id/tvRowPrayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="الفجر" />

    <!-- "القادمة" Badge -->
    <TextView
        android:id="@+id/tvRowBadgeNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_badge"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:text="الصلاة القادمة"
        android:textColor="@color/gold_light"
        android:textSize="11sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Prayer Time (12-hr format) -->
    <TextView
        android:id="@+id/tvRowPrayerTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/gold_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="05:12 ص" />

</LinearLayout>
