<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Go_to_pray" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorSecondary">@color/emerald_accent</item>
    </style>

    <style name="Theme.Go_to_pray" parent="Base.Theme.Go_to_pray" />

    <style name="Theme.Go_to_pray.AlarmActivity" parent="Theme.Material3.DayNight.NoActionBar">
